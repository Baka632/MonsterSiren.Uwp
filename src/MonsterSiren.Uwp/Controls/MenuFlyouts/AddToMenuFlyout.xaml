<local:AddToMenuFlyoutBase
    x:Class="MonsterSiren.Uwp.Controls.MenuFlyouts.AddToMenuFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MonsterSiren.Uwp.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MonsterSiren.Uwp.Controls.MenuFlyouts"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loading="OnAddToMenuFlyoutLoading"
    mc:Ignorable="d">
    <MenuFlyoutItem
        x:Uid="NowPlayingMenuFlyout"
        controls:CommandParameterXamlHelper.SourceData="{x:Bind SourceData, Mode=OneWay}"
        Command="{x:Bind ViewModel.AddToNowPlayingCommand}"
        Icon="MusicInfo" />
    <MenuFlyoutSubItem
        x:Name="AddToPlaylistMenuFlyoutSubItem"
        x:Uid="AddToPlaylistMenuFlyout"
        Icon="List" />
</local:AddToMenuFlyoutBase>
