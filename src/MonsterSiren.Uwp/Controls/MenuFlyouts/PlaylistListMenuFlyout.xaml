<local:ListMenuFlyoutBase
    x:Class="MonsterSiren.Uwp.Controls.MenuFlyouts.PlaylistListMenuFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MonsterSiren.Uwp.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MonsterSiren.Uwp.Controls.MenuFlyouts"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Opening="OnPlaylistListMenuFlyoutOpening"
    mc:Ignorable="d">
    <MenuFlyoutItem
        x:Uid="PlayCommandButton"
        controls:CommandParameterXamlHelper.CallbackCommand="{x:Bind MultipleOperationEndCallbackCommand}"
        controls:CommandParameterXamlHelper.SourceData="{x:Bind SourceData, Mode=OneWay}"
        Command="{x:Bind ViewModel.PlayCommand}"
        Icon="Play" />
    <MenuFlyoutItem
        x:Uid="PlayNext"
        controls:CommandParameterXamlHelper.CallbackCommand="{x:Bind MultipleOperationEndCallbackCommand}"
        controls:CommandParameterXamlHelper.SourceData="{x:Bind SourceData, Mode=OneWay}"
        Command="{x:Bind ViewModel.PlayNextCommand}"
        Icon="Forward" />
    <MenuFlyoutSubItem Tag="Placeholder_For_AddTo" />
    <MenuFlyoutItem
        x:Uid="DeleteCommandButton"
        controls:CommandParameterXamlHelper.CallbackCommand="{x:Bind MultipleOperationEndCallbackCommand}"
        controls:CommandParameterXamlHelper.SourceData="{x:Bind SourceData, Mode=OneWay}"
        Command="{x:Bind ViewModel.RemovePlaylistCommand}"
        Icon="Delete" />
    <MenuFlyoutSeparator />
    <MenuFlyoutItem
        x:Uid="SelectAllForSongList"
        Command="{x:Bind SelectAllListCommand}"
        Icon="SelectAll" />
    <MenuFlyoutItem
        x:Uid="DeselectAllForSongList"
        Command="{x:Bind DeselectAllListCommand}"
        Icon="ClearSelection" />
    <MenuFlyoutItem
        x:Uid="DeselectForSongList"
        Command="{x:Bind StopMultipleSelectionCommand}"
        Icon="Cancel" />
</local:ListMenuFlyoutBase>
