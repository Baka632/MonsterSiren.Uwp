<local:ListMenuFlyoutBase
    x:Class="MonsterSiren.Uwp.Controls.MenuFlyouts.AlbumListMenuFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MonsterSiren.Uwp.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MonsterSiren.Uwp.Controls.MenuFlyouts"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Opening="OnAlbumListMenuFlyoutOpening"
    mc:Ignorable="d">
    <MenuFlyoutItem
        x:Uid="PlayCommandButton"
        controls:CommandParameterXamlHelper.CallbackCommand="{x:Bind MultipleOperationEndCallbackCommand}"
        controls:CommandParameterXamlHelper.SourceData="{x:Bind SourceData, Mode=OneWay}"
        Command="{x:Bind ViewModel.PlayCommand}"
        Icon="Play" />
    <MenuFlyoutItem
        x:Uid="PlayNext"
        controls:CommandParameterXamlHelper.CallbackCommand="{x:Bind MultipleOperationEndCallbackCommand}"
        controls:CommandParameterXamlHelper.SourceData="{x:Bind SourceData, Mode=OneWay}"
        Command="{x:Bind ViewModel.PlayNextCommand}"
        Icon="Forward" />
    <MenuFlyoutSubItem Tag="Placeholder_For_AddTo" />
    <MenuFlyoutItem
        x:Uid="BatchAddToFavorite"
        controls:CommandParameterXamlHelper.CallbackCommand="{x:Bind MultipleOperationEndCallbackCommand}"
        controls:CommandParameterXamlHelper.SourceData="{x:Bind SourceData, Mode=OneWay}"
        Command="{x:Bind ViewModel.AddItemToFavoriteCommand}"
        Visibility="{x:Bind FavoriteVisibility, Mode=OneWay}">
        <MenuFlyoutItem.Icon>
            <FontIcon Glyph="&#xE728;" />
        </MenuFlyoutItem.Icon>
    </MenuFlyoutItem>
    <MenuFlyoutItem
        x:Uid="RemoveFromFavorite"
        controls:CommandParameterXamlHelper.CallbackCommand="{x:Bind MultipleOperationEndCallbackCommand}"
        controls:CommandParameterXamlHelper.SourceData="{x:Bind SourceData, Mode=OneWay}"
        Command="{x:Bind ViewModel.RemoveItemFromFavoriteCommand}"
        Icon="UnFavorite"
        Visibility="{x:Bind UnfavoriteVisibility, Mode=OneWay}" />
    <MenuFlyoutItem
        x:Uid="DownloadAlbumCommandButton"
        controls:CommandParameterXamlHelper.CallbackCommand="{x:Bind MultipleOperationEndCallbackCommand}"
        controls:CommandParameterXamlHelper.SourceData="{x:Bind SourceData, Mode=OneWay}"
        Command="{x:Bind ViewModel.StartDownloadCommand}"
        Icon="Download" />
    <MenuFlyoutSeparator />
    <MenuFlyoutItem
        x:Uid="SelectAllForSongList"
        controls:CommandParameterXamlHelper.SourceData="{x:Bind SourceData, Mode=OneWay}"
        Command="{x:Bind SelectAllListCommand, Mode=OneWay}"
        Icon="SelectAll" />
    <MenuFlyoutItem
        x:Uid="DeselectAllForSongList"
        controls:CommandParameterXamlHelper.SourceData="{x:Bind SourceData, Mode=OneWay}"
        Command="{x:Bind DeselectAllListCommand, Mode=OneWay}"
        Icon="ClearSelection" />
    <MenuFlyoutItem
        x:Uid="DeselectForSongList"
        controls:CommandParameterXamlHelper.SourceData="{x:Bind SourceData, Mode=OneWay}"
        Command="{x:Bind StopMultipleSelectionCommand, Mode=OneWay}"
        Icon="Cancel" />
</local:ListMenuFlyoutBase>
