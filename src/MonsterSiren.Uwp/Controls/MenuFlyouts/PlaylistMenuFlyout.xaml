<local:ItemMenuFlyoutBase
    x:Class="MonsterSiren.Uwp.Controls.MenuFlyouts.PlaylistMenuFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:MonsterSiren.Uwp.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MonsterSiren.Uwp.Controls.MenuFlyouts"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Opening="OnPlaylistMenuFlyoutOpening"
    mc:Ignorable="d">
    <MenuFlyoutItem
        x:Uid="PlayCommandButton"
        controls:CommandParameterXamlHelper.SourceData="{x:Bind SourceData, Mode=OneWay}"
        Command="{x:Bind ViewModel.PlayCommand}"
        Icon="Play" />
    <MenuFlyoutItem
        x:Uid="PlayNext"
        controls:CommandParameterXamlHelper.SourceData="{x:Bind SourceData, Mode=OneWay}"
        Command="{x:Bind ViewModel.PlayNextCommand}"
        Icon="Forward" />
    <MenuFlyoutSubItem Tag="Placeholder_For_AddTo" />
    <MenuFlyoutItem
        x:Uid="ModifyCommandButton"
        controls:CommandParameterXamlHelper.SourceData="{x:Bind SourceData, Mode=OneWay}"
        Command="{x:Bind ViewModel.ModifyPlaylistCommand}"
        Icon="Edit" />
    <MenuFlyoutItem
        x:Uid="DeleteCommandButton"
        controls:CommandParameterXamlHelper.SourceData="{x:Bind SourceData, Mode=OneWay}"
        Command="{x:Bind ViewModel.RemovePlaylistCommand}"
        Icon="Delete" />
    <MenuFlyoutSeparator Visibility="{x:Bind MultipleSelectionVisibility, Mode=OneWay}" />
    <MenuFlyoutItem
        x:Uid="SelectForSongList"
        Command="{x:Bind StartMultipleSelectionCommand}"
        Visibility="{x:Bind MultipleSelectionVisibility, Mode=OneWay}">
        <MenuFlyoutItem.Icon>
            <FontIcon Glyph="&#xE762;" />
        </MenuFlyoutItem.Icon>
    </MenuFlyoutItem>
</local:ItemMenuFlyoutBase>
