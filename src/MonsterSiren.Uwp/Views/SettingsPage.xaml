<Page
    x:Class="MonsterSiren.Uwp.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MonsterSiren.Uwp.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:parts="using:MonsterSiren.Uwp.Views.SettingsPageParts"
    xmlns:viewmodels="using:MonsterSiren.Uwp.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
    Loaded="OnSettingsPageLoaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,5"
            Orientation="Horizontal">
            <FontIcon
                Margin="0,0,10,0"
                HorizontalAlignment="Center"
                FontSize="40"
                Glyph="&#xE115;" />
            <TextBlock
                x:Uid="SettingsTextBlock"
                Margin="0,0,5,0"
                HorizontalAlignment="Center"
                FontSize="30" />
        </StackPanel>

        <Pivot Grid.Row="1" Margin="-10,0,0,0">
            <PivotItem x:Uid="PresentationPivotItem">
                <parts:PresentationSection ViewModel="{x:Bind ViewModel}" />
            </PivotItem>

            <PivotItem x:Uid="PlaybackSectionPivotItem">
                <parts:PlaybackSection ViewModel="{x:Bind ViewModel}" />
            </PivotItem>

            <PivotItem x:Uid="DownloadPivotItem">
                <parts:DownloadSection ViewModel="{x:Bind ViewModel}" />
            </PivotItem>

            <PivotItem x:Uid="AboutPivotItem">
                <parts:AboutSection ViewModel="{x:Bind ViewModel}" />
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
